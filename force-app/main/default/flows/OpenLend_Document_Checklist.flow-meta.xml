    <description>Runs when a Loan Application is created. Builds the document checklist from the loan type, requested amount, and borrower type. Thresholds come from the Default OpenLend Setting record. Applications created by the intake flow get their checklist from this flow.</description>
    <environments>Default</environments>
    <formulas>
        <description>Every borrower type except a sole proprietor has formation documents.</description>
        <name>fxNeedsEntityDocuments</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISPICKVAL({!$Record.Borrower_Type__c}, "Sole Proprietor"))</expression>
    </formulas>
    <formulas>
        <description>Owners' personal financials are needed for sole proprietors, partnerships, and larger requests.</description>
        <name>fxNeedsPersonalDocuments</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISPICKVAL({!$Record.Borrower_Type__c}, "Sole Proprietor"), ISPICKVAL({!$Record.Borrower_Type__c}, "Partnership"), {!$Record.Requested_Amount__c} &gt;= {!Get_Settings.Guarantor_Document_Threshold__c})</expression>
    </formulas>
    <formulas>
        <description>Secured loan types, or any product flagged Collateral Required.</description>
        <name>fxIsSecured</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISPICKVAL({!$Record.Loan_Type__c}, "Commercial Real Estate"), ISPICKVAL({!$Record.Loan_Type__c}, "Construction"), ISPICKVAL({!$Record.Loan_Type__c}, "Equipment Finance"), {!$Record.Loan_Product__r.Collateral_Required__c})</expression>
    </formulas>
    <formulas>
        <name>fxIsRealEstate</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISPICKVAL({!$Record.Loan_Type__c}, "Commercial Real Estate"), ISPICKVAL({!$Record.Loan_Type__c}, "Construction"))</expression>
    </formulas>
    <formulas>
        <name>fxNeedsEnvironmental</name>
        <dataType>Boolean</dataType>
        <expression>AND({!fxIsRealEstate}, {!$Record.Requested_Amount__c} &gt;= {!Get_Settings.Environmental_Report_Threshold__c})</expression>
    </formulas>
    <formulas>
        <name>fxNeedsInterimFinancials</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Requested_Amount__c} &gt;= {!Get_Settings.Enhanced_Financials_Threshold__c}</expression>
    </formulas>
