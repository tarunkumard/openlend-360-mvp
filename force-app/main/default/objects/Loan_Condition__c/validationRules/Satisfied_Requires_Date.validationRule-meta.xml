<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Satisfied_Requires_Date</fullName>
    <active>true</active>
    <description>A satisfied date is required when a condition is satisfied.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Satisfied"), ISBLANK(Satisfied_Date__c))</errorConditionFormula>
    <errorDisplayField>Satisfied_Date__c</errorDisplayField>
    <errorMessage>Enter the Satisfied Date.</errorMessage>
</ValidationRule>
