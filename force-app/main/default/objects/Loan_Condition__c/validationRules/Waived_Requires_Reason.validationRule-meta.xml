<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Waived_Requires_Reason</fullName>
    <active>true</active>
    <description>A waiver reason is required when a condition is waived.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Waived"), ISBLANK(Waiver_Reason__c))</errorConditionFormula>
    <errorDisplayField>Waiver_Reason__c</errorDisplayField>
    <errorMessage>Enter a Waiver Reason.</errorMessage>
</ValidationRule>
