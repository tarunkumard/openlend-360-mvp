<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Blocked_Requires_Reason</fullName>
    <active>true</active>
    <description>A blocked reason is required when a work item is blocked.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Blocked"), ISBLANK(Blocked_Reason__c))</errorConditionFormula>
    <errorDisplayField>Blocked_Reason__c</errorDisplayField>
    <errorMessage>Enter a Blocked Reason.</errorMessage>
</ValidationRule>
