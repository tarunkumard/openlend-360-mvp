<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Done_Requires_Completed_Date</fullName>
    <active>true</active>
    <description>A completed date is required when a work item is done.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Done"), ISBLANK(Completed_Date__c))</errorConditionFormula>
    <errorDisplayField>Completed_Date__c</errorDisplayField>
    <errorMessage>Enter the Completed Date.</errorMessage>
</ValidationRule>
