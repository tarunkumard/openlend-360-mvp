<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Conditions_Completion_Percent__c</fullName>
    <description>Share of conditions that are satisfied or waived.</description>
    <inlineHelpText>Share of conditions satisfied or waived.</inlineHelpText>
    <label>Conditions Completion %</label>
    <formula>IF(Total_Condition_Count__c &gt; 0, Cleared_Condition_Count__c / Total_Condition_Count__c, NULL)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>18</precision>
    <scale>2</scale>
    <type>Percent</type>
</CustomField>
