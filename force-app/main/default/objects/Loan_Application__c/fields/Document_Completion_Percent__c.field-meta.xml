<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Document_Completion_Percent__c</fullName>
    <description>Share of required documents that are accepted or waived.</description>
    <inlineHelpText>Share of required documents accepted or waived.</inlineHelpText>
    <label>Document Completion %</label>
    <formula>IF(Required_Document_Count__c &gt; 0, (Required_Document_Count__c - Required_Documents_Outstanding__c) / Required_Document_Count__c, NULL)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>18</precision>
    <scale>2</scale>
    <type>Percent</type>
</CustomField>
