<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Declined_Requires_Reason</fullName>
    <active>true</active>
    <description>A decline reason is required when the application is declined.</description>
    <errorConditionFormula>AND(ISPICKVAL(Stage__c, "Declined"), ISBLANK(TEXT(Decline_Reason__c)))</errorConditionFormula>
    <errorDisplayField>Decline_Reason__c</errorDisplayField>
    <errorMessage>Select a Decline Reason.</errorMessage>
</ValidationRule>
