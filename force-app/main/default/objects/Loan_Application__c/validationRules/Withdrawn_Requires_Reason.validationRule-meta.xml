<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Withdrawn_Requires_Reason</fullName>
    <active>true</active>
    <description>A withdrawal reason is required when the application is withdrawn.</description>
    <errorConditionFormula>AND(ISPICKVAL(Stage__c, "Withdrawn"), ISBLANK(TEXT(Withdrawal_Reason__c)))</errorConditionFormula>
    <errorDisplayField>Withdrawal_Reason__c</errorDisplayField>
    <errorMessage>Select a Withdrawal Reason.</errorMessage>
</ValidationRule>
