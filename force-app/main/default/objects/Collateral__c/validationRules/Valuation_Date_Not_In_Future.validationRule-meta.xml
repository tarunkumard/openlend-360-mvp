<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valuation_Date_Not_In_Future</fullName>
    <active>true</active>
    <description>Valuation date cannot be in the future.</description>
    <errorConditionFormula>Valuation_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Valuation_Date__c</errorDisplayField>
    <errorMessage>Valuation Date cannot be in the future.</errorMessage>
</ValidationRule>
