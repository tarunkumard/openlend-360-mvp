<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Appraised_Value_Must_Be_Positive</fullName>
    <active>true</active>
    <description>Appraised value must be greater than zero.</description>
    <errorConditionFormula>Appraised_Value__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Appraised_Value__c</errorDisplayField>
    <errorMessage>Appraised Value must be greater than zero.</errorMessage>
</ValidationRule>
