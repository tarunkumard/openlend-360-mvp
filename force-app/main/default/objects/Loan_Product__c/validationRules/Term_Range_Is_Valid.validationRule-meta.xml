<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Term_Range_Is_Valid</fullName>
    <active>true</active>
    <description>Minimum term cannot exceed maximum term.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Minimum_Term_Months__c)), NOT(ISBLANK(Maximum_Term_Months__c)), Minimum_Term_Months__c &gt; Maximum_Term_Months__c)</errorConditionFormula>
    <errorDisplayField>Minimum_Term_Months__c</errorDisplayField>
    <errorMessage>Minimum Term Months cannot be greater than Maximum Term Months.</errorMessage>
</ValidationRule>
