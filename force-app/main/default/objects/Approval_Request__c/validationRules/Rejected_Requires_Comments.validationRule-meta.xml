<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rejected_Requires_Comments</fullName>
    <active>true</active>
    <description>Decision comments are required when a request is rejected.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Rejected"), LEN(Decision_Comments__c) = 0)</errorConditionFormula>
    <errorDisplayField>Decision_Comments__c</errorDisplayField>
    <errorMessage>Enter Decision Comments explaining the rejection.</errorMessage>
</ValidationRule>
