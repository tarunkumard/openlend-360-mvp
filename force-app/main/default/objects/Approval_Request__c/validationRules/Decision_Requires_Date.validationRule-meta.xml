<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Decision_Requires_Date</fullName>
    <active>true</active>
    <description>A decision date is required once a request is approved or rejected.</description>
    <errorConditionFormula>AND(OR(ISPICKVAL(Status__c, "Approved"), ISPICKVAL(Status__c, "Rejected")), ISBLANK(Decision_Date__c))</errorConditionFormula>
    <errorDisplayField>Decision_Date__c</errorDisplayField>
    <errorMessage>Enter the Decision Date.</errorMessage>
</ValidationRule>
