<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rejected_Requires_Reason</fullName>
    <active>true</active>
    <description>A rejection reason is required when a document is rejected.</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Rejected"), ISBLANK(Rejection_Reason__c))</errorConditionFormula>
    <errorDisplayField>Rejection_Reason__c</errorDisplayField>
    <errorMessage>Enter a Rejection Reason.</errorMessage>
</ValidationRule>
